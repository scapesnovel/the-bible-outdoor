<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OwnerStudio" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#0A1622</item>
        <item name="android:statusBarColor">#0A1622</item>
        <item name="android:navigationBarColor">#0A1622</item>
        <item name="colorPrimary">#CFA85E</item>
        <item name="colorAccent">#CFA85E</item>
    </style>

    <!-- Native launch splash: shows the INSTANT the icon is tapped -->
    <style name="Theme.OwnerStudio.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A1622</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.OwnerStudio</item>
    </style>
</resources>
